# Flexo SysML v2 API. JWT_* and FLEXO_AUTH come from .env.
FLEXO_HOST=layer1-service
FLEXO_PROTOCOL=http
FLEXO_PORT=8080
FLEXO_SYSMLV2_ORG=sysmlv2
# Textual notation via OpenSysML sysml-grpc (host:port, no scheme).
# Comment this out to disable notation: posts then answer 415, reads 406.
FLEXO_OPENSYSML_URL=opensysml:50051
# off | warn | reject  (warn/reject require FLEXO_OPENSYSML_URL)
FLEXO_OPENSYSML_VALIDATE=warn
