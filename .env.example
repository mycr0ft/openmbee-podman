# Copy to .env (bin/bootstrap.sh does this and fills the secrets in).
# podman-compose reads this file for ${VAR} interpolation in compose.yaml.

# Interface the published ports bind to. 127.0.0.1 keeps the stack private to
# this machine; use 0.0.0.0 (or a LAN address) to reach it from elsewhere.
BIND_ADDR=127.0.0.1

# --- published host ports -------------------------------------------------
# Remapped where this box already listens: 8081 and 8083 were taken by other
# containers, so store-service and the SysML v2 API use 18xxx here.
LAYER1_PORT=8080
AUTH_PORT=8082
STORE_PORT=8081
SYSMLV2_PORT=8083
QUAD_PORT=3030
MINIO_PORT=9000
LDAP_PORT=1389

# --- LDAP demo identities (Flexo's standard fixtures) ---------------------
LDAP_ADMIN_PASSWORD=adminpassword
LDAP_USERS=user01,user02
LDAP_PASSWORDS=password1,password2
DEMO_USER=user01
DEMO_PASSWORD=password1

# --- JWT shared by layer1, auth, store and sysmlv2 ------------------------
JWT_DOMAIN=http://flexo-mms-services
JWT_AUDIENCE=flexo-mms-audience
JWT_REALM=flexo-mms
JWT_SECRET=CHANGEME

# --- MinIO / S3 (store-service) ------------------------------------------
S3_ACCESS_KEY=CHANGEME
S3_SECRET_KEY=CHANGEME
S3_REGION=us-east-1

# --- Flexo SysML v2 API --------------------------------------------------
FLEXO_SYSMLV2_ORG=sysmlv2
# Static bearer token ("Bearer eyJ...") minted by bin/bootstrap.sh, used only
# when a request arrives without an Authorization header. Empty it to require
# explicit auth on every call.
FLEXO_AUTH=CHANGEME
